# Writers — this is what invents the film. At least one is required.
# Claude is the stronger writer; gpt-5.6 is steadier under the 60s function
# limit. Set both to switch between them from the UI.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Which writer to preselect: "claude" (claude-opus-4-8) or "openai" (gpt-5.6-terra).
# Unset = whichever has a key, Claude first.
TEXT_PROVIDER=claude

# Override the OpenAI writer's model. Default is gpt-5.6-terra (balanced).
# Deliberately NOT the bare "gpt-5.6" alias — that is gpt-5.6-sol, the frontier
# tier, which is the slowest and dearest of the three ($5/$30 per MTok) and is
# built for work harder than inventing a B-movie. Drop to gpt-5.6-luna if terra
# is still too slow, or raise to gpt-5.6-sol if you want the best writing and
# have the seconds to spare.
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Proofreading the finished poster is a Claude vision call, so it needs
# ANTHROPIC_API_KEY whichever writer you pick. Without that key posters still
# generate — they just don't get checked.

# Image generation. At least one is required; set both to A/B them.
# OPENAI_API_KEY above is shared: it covers gpt-5.6 and gpt-image-2 both.
GEMINI_API_KEY=...

# Which provider to preselect: "openai" (gpt-image-2) or "gemini" (gemini-3.1-flash-image).
IMAGE_PROVIDER=openai
