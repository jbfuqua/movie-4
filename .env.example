# Required — writes the film and proofreads the finished poster.
ANTHROPIC_API_KEY=sk-ant-...

# Image generation. At least one is required; set both to A/B them.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Which provider to preselect: "openai" (gpt-image-2) or "gemini" (gemini-3.1-flash-image).
IMAGE_PROVIDER=openai
